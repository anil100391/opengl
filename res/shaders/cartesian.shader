// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
#shader vertex
#version 330 core

layout(location = 0) in vec3 position;

uniform mat4 u_M;
uniform mat4 u_V;
uniform mat4 u_P;

out vec3 v_pos;

// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
void main()
{
    gl_Position = u_P * u_V * u_M * vec4(position, 1.0);
    v_pos = position;
};

// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
#shader fragment
#version 330 core

in vec3 v_pos;

// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
float plot()
{
    return 1.0;
}

// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
void main()
{
    float SPAN     = 10.0;
    float segments = 10.0;
    vec4 MIN = vec4( -1.0 * SPAN, -1.0 * SPAN, 0.0, 1.0 );
    vec4 MAX = vec4( SPAN, SPAN, 0.0, 1.0 );

    float maj_u = mod( ((v_pos.x - MIN.x) / 2), 1.0 );
    float maj_v = mod( ((v_pos.y - MIN.y) / 2), 1.0 );

    maj_u = smoothstep( 0, 0.02, maj_u );
    maj_v = smoothstep( 0, 0.02, maj_v );

    float min_u = mod( ((v_pos.x - MIN.x) / 2), 0.5 );
    float min_v = mod( ((v_pos.y - MIN.y) / 2), 0.5 );

    min_u = smoothstep( 0, 0.02, min_u );
    min_v = smoothstep( 0, 0.02, min_v );

    gl_FragColor = 0.2 * (1.0 - maj_u * maj_v) * vec4( 1.0, 1.0, 1.0, 1.0 ) + 0.4 * (1.0 - min_u * min_v) * vec4( 1.0, 1.0, 1.0, 1.0 );
}

